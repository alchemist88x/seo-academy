# ==============================================================================
# SEO Academy — Environment Configuration Template
# Copy this file to .env and configure for your environment:
#   cp .env.example .env
#   php artisan key:generate
# ==============================================================================

# ------------------------------------------------------------------------------
# Application Environment
# ------------------------------------------------------------------------------
APP_NAME="SEO Academy"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database
# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# ------------------------------------------------------------------------------
# Logging Configuration
# ------------------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ------------------------------------------------------------------------------
# Database Configuration
# Supported Database Engines:
#   1. SQLite 3.35+ (Default - recommended for single academy / shared hosting)
#   2. MySQL 8.4+ InnoDB / MariaDB 10.11+
# ------------------------------------------------------------------------------
# Default: SQLite
DB_CONNECTION=sqlite
# Leave DB_DATABASE blank to use default location (storage/app/private/database.sqlite)
# Or specify an absolute file path:
# DB_DATABASE=/path/to/database.sqlite
DB_FOREIGN_KEYS=true
DB_SQLITE_BUSY_TIMEOUT=5000
DB_SQLITE_JOURNAL_MODE=WAL
DB_SQLITE_SYNCHRONOUS=NORMAL

# Alternative: MySQL 8.4+ InnoDB
# Uncomment the following lines to use MySQL instead of SQLite:
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=seo_academy
# DB_USERNAME=your_db_username
# DB_PASSWORD=your_db_password
# DB_CHARSET=utf8mb4
# DB_COLLATION=utf8mb4_unicode_ci
# MYSQL_ATTR_SSL_CA=

# ------------------------------------------------------------------------------
# Session Configuration
# ------------------------------------------------------------------------------
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# ------------------------------------------------------------------------------
# Cache & Queue Configuration
# Compatible with shared hosting without Redis or external queue workers.
# ------------------------------------------------------------------------------
CACHE_STORE=file
# CACHE_PREFIX=
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log

# Optional Redis Configuration (if external Redis cache/queue is utilized)
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ------------------------------------------------------------------------------
# Filesystem & Storage Configuration
# ------------------------------------------------------------------------------
FILESYSTEM_DISK=local

# ------------------------------------------------------------------------------
# Mail & SMTP Configuration
# In production, set MAIL_MAILER=smtp and configure your mail server.
# ------------------------------------------------------------------------------
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="academy@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ------------------------------------------------------------------------------
# Frontend Asset Configuration
# ------------------------------------------------------------------------------
VITE_APP_NAME="${APP_NAME}"

# ------------------------------------------------------------------------------
# Optional Third-Party Services & Integrations
# ------------------------------------------------------------------------------
# Postmark
POSTMARK_API_KEY=

# Resend
RESEND_API_KEY=

# Amazon SES / S3 Storage (Optional)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Slack Notification Webhooks (Optional)
SLACK_BOT_USER_DEFAULT_CHANNEL=
SLACK_BOT_USER_OAUTH_TOKEN=

# ------------------------------------------------------------------------------
# Optional LMS AI Assistant Configuration
# ------------------------------------------------------------------------------
LMS_AI_ENABLED=false
LMS_AI_DRIVER=null
LMS_MAX_MESSAGES_PER_MINUTE=10
LMS_MAX_INPUT_CHARACTERS=4000
LMS_SUPPORT_EMAIL=support@example.com
LMS_AI_MODEL=gpt-4.1-mini
LMS_AI_ENDPOINT=
OPENAI_API_KEY=
